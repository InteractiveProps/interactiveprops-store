rules_version = '2';

// ============================================================================
// Interactive Props — reglas de seguridad de Firestore
//
// Pégalas en: console.firebase.google.com > proyecto interactiveprop-store
//             > Firestore Database > pestaña "Reglas" > Publicar
//
// Idea general: el catálogo es público (la tienda tiene que poder mostrarlo sin
// que nadie inicie sesión), pero SOLO el admin autenticado puede modificarlo o
// ver los pedidos.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = cualquiera que haya iniciado sesión con Firebase Auth.
    // Como solo existe el usuario que creas en la consola, esto equivale a "tú".
    // Para atornillarlo más, ver la nota al final del archivo.
    function esAdmin() {
      return request.auth != null;
    }

    // Un pedido con forma razonable. No evita que alguien mande basura a mano,
    // pero sí que escriba cualquier cosa o infle el documento.
    function pedidoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'date', 'items', 'total', 'shipping'])
          && d.total is number && d.total > 0 && d.total < 100000
          && d.items is list && d.items.size() > 0 && d.items.size() <= 50
          && d.shipping is map
          && d.status == 'paid';
    }

    // ---------------------------------------------------------------- catálogo
    // settings/products y settings/logo.
    // Lectura pública: la tienda los necesita para pintar los productos y el
    // logo a cualquier visitante. Escritura: solo el admin.
    match /settings/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ------------------------------------------------------------------ pedidos
    // El comprador NO tiene sesión, así que tiene que poder crear su pedido al
    // terminar el pago. Pero no puede leer los de nadie (ni el suyo), ni
    // modificarlos ni borrarlos: eso es solo del admin.
    match /orders/{doc} {
      allow create: if pedidoValido();
      allow read, update, delete: if esAdmin();
    }

    // ---------------------------------------------------------------- licencias
    // Para el juego (Donut Bridge). Cerrada del todo al navegador: si el cliente
    // pudiera escribir aquí, cualquiera se regalaría una licencia sin pagar; y si
    // pudiera leer, se llevaría la lista entera de tokens.
    // Las funciones de servidor (api/comprar.js, api/juego.js) usan el SDK de
    // administrador, que NO pasa por estas reglas, así que siguen funcionando.
    match /licencias/{doc} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------- todo lo demás
    // Cualquier colección que no esté nombrada arriba queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================================
// NOTA — cómo atornillarlo aún más (opcional, cuando tengas el usuario creado)
//
// Cambia esAdmin() por tu UID concreto, para que si algún día habilitas otro
// método de registro, un usuario nuevo no herede permisos de admin:
//
//   function esAdmin() {
//     return request.auth != null
//         && request.auth.uid == 'PEGA_AQUI_TU_UID';
//   }
//
// El UID lo ves en Authentication > Users, en la columna "User UID".
// ============================================================================
