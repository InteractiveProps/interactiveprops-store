    { "source": "/games", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/shipping", "destination": "/index.html" },
    { "source": "/returns", "destination": "/index.html" },
    { "source": "/warranty", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/comprar-donut-bridge", "destination": "/index.html" }
